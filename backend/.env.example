# HAP 鉴权配置（也可在系统设置页面配置）
HAP_APP_ID=
HAP_APPKEY=
HAP_SIGN=
HAP_BASE_URL=https://api.mingdao.com

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# PostgreSQL 配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aps_hap
# 本地单机模式（SQLite，零运维；注释掉上一行后启用本行）
# DATABASE_URL=sqlite+aiosqlite:///./data/mps.db

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 求解引擎配置
OPENAPS_HOME=./openaps
SOLVER_ENGINE=ortools

# API 安全配置
API_KEY=aps-hap-secret-key
